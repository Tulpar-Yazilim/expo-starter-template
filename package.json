{
  "name": "react-native-template",
  "version": "1.8.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env EXPO_NO_DOTENV=1 expo start",
    "prebuild": "cross-env EXPO_NO_DOTENV=1 yarn expo prebuild",
    "start:development": "cross-env APP_ENV=development yarn start",
    "prebuild:development": "cross-env APP_ENV=development yarn prebuild",
    "android": "cross-env EXPO_NO_DOTENV=1 expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 expo run:ios",
    "web": "cross-env EXPO_NO_DOTENV=1 expo start --web --reset-cache",
    "build:development:android": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform android ",
    "build:development:ios": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform ios",
    "build:development:web": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 expo export -c --platform web",
    "submit:development:mobile": "cross-env APP_ENV=development eas submit --profile development",
    "start:qa": "cross-env APP_ENV=qa yarn start",
    "prebuild:qa": "cross-env APP_ENV=qa yarn prebuild",
    "android:qa": "cross-env APP_ENV=qa yarn android",
    "ios:qa": "cross-env APP_ENV=qa yarn ios",
    "web:qa": "cross-env APP_ENV=qa yarn web",
    "build:qa:android": "cross-env APP_ENV=qa EXPO_NO_DOTENV=1 eas build --profile qa --platform android ",
    "build:qa:ios": "cross-env APP_ENV=qa EXPO_NO_DOTENV=1 eas build --profile qa --platform ios",
    "build:qa:web": "cross-env APP_ENV=qa EXPO_NO_DOTENV=1 expo export -c --platform web",
    "submit:qa:mobile": "cross-env APP_ENV=qa eas submit --profile qa",
    "start:staging": "cross-env APP_ENV=staging yarn start",
    "prebuild:staging": "cross-env APP_ENV=staging yarn prebuild",
    "android:staging": "cross-env APP_ENV=staging yarn android",
    "ios:staging": "cross-env APP_ENV=staging yarn ios",
    "web:staging": "cross-env APP_ENV=staging yarn web",
    "build:staging:android": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform android ",
    "build:staging:ios": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform ios",
    "build:staging:web": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 expo export -c --platform web",
    "submit:staging:mobile": "cross-env APP_ENV=staging eas submit --profile staging",
    "start:production": "cross-env APP_ENV=production yarn start",
    "prebuild:production": "cross-env APP_ENV=production yarn prebuild",
    "android:production": "cross-env APP_ENV=production yarn android",
    "ios:production": "cross-env APP_ENV=production yarn ios",
    "web:production": "cross-env APP_ENV=production yarn web",
    "build:production:android": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform android ",
    "build:production:ios": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform ios",
    "build:production:web": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 expo export -c --platform web",
    "submit:production:mobile": "cross-env APP_ENV=production eas submit --profile production",
    "credentials:ios": "eas credentials --platform ios",
    "credentials:android": "eas credentials --platform android",
    "release-aab": "cd android && ./gradlew bundleRelease && cd ..",
    "release-apk": "cd android && ./gradlew assembleRelease  && cd ..",
    "prepare": "husky",
    "xcode": "xed -b ios",
    "doctor": "npx expo-doctor@latest",
    "preinstall": "npx only-allow yarn",
    "app-release": "cross-env SKIP_BRANCH_PROTECTION=true np --no-publish --no-cleanup --no-release-draft --message 'chore: release template v%s'",
    "version": "git add package.json",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noemit",
    "lint:translations": "eslint ./src/translations/ --fix --ext .json  ",
    "test": "jest",
    "check-all": "yarn lint && yarn type-check && yarn lint:translations && yarn test",
    "test:ci": "yarn test --coverage",
    "test:watch": "yarn test --watch",
    "install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e-test": "maestro test .maestro/ -e APP_ID=com.expoapp.development"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^3.10.0",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/jest-preset": "0.85.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.101.1",
    "@testing-library/react-hooks": "^8.0.1",
    "app-icon-badge": "^0.1.2",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "expo": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "i18next": "^26.3.1",
    "lodash.memoize": "^4.1.2",
    "moti": "^0.30.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-controller": "1.21.12",
    "react-native-mmkv": "~4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.4.1",
    "react-native-restart": "0.0.28",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.9.2",
    "react-query-kit": "^3.3.0",
    "tailwind-variants": "^0.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^19.2.2",
    "@commitlint/config-conventional": "^19.2.2",
    "@dev-plugins/react-query": "^0.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@expo/config": "^56.0.9",
    "@tanstack/eslint-plugin-query": "^5.101.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/i18n-js": "^3.8.9",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^30.0.0",
    "@types/lodash.memoize": "^4.1.9",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29",
    "jest-environment-jsdom": "^30.4.1",
    "jest-expo": "~56.0.5",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.0.8",
    "np": "^11.2.1",
    "prettier": "^3.8.4",
    "tailwindcss": "3.4.19",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "resolutions": {
    "hermes-compiler": "250829098.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tulpar-Yazilim/expo-starter-template.git"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-restart"
        ]
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  }
}
